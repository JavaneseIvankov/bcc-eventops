{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Spesifikasi REST API untuk BCC EventOps. Auth menggunakan HTTP-Only Cookie (access_token \u0026 refresh_token). Konvensi JSON snake_case, ID UUID v4, waktu ISO 8601.",
        "title": "BCC EventOps API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "BCC EventOps Team",
            "email": "dev@bcc.id"
        },
        "version": "1.0.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login pengguna dengan email dan password",
                "parameters": [
                    {
                        "description": "Kredensial login",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_bcc_eventops-be_internal_dto.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_bcc_eventops-be_internal_dto.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Data yang dikirim tidak valid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Email atau password salah",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Logout dan menghapus cookie autentikasi",
                "responses": {
                    "200": {
                        "description": "Logout berhasil",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Mendapatkan profil pengguna yang sedang login",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_bcc_eventops-be_internal_dto.UserResponse"
                        }
                    },
                    "401": {
                        "description": "Autentikasi diperlukan",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/refresh": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Memperbarui access_token menggunakan refresh_token dari cookie",
                "responses": {
                    "200": {
                        "description": "Token berhasil diperbarui",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Autentikasi diperlukan",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Registrasi akun pengguna baru",
                "parameters": [
                    {
                        "description": "Data registrasi",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_bcc_eventops-be_internal_dto.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/github_com_bcc_eventops-be_internal_dto.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Data yang dikirim tidak valid",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Email sudah terdaftar",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_bcc_eventops-be_internal_dto.LoginRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "github_com_bcc_eventops-be_internal_dto.RegisterRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "github_com_bcc_eventops-be_internal_dto.UserResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "cookieAuth": {
            "description": "HTTP-Only Cookie berisi JWT Access Token",
            "type": "apiKey",
            "name": "access_token",
            "in": "cookie"
        }
    }
}